# Banco de Dados
DB_NAME=rsvp_db
DB_USER=root
DB_PASSWORD=
DB_HOST=db

# Flask
SECRET_KEY=

# Opcionais
TZ_OFFSET_HOURS=-3
# Nome-base do log: o app grava logs/app-AAAA-MM-DD.log (1 arquivo por dia, data UTC)
# Não altere: o purge-logs.sh só apaga logs/app-AAAA-MM-DD.log (outro nome/diretório = sem retenção)
LOG_FILE=logs/app.log
# Dias de logs/app-*.log mantidos (purge diário no container backup)
LOG_RETENTION_DAYS=5
UPLOAD_FOLDER=/app/uploads   # volume nomeado Docker; em dev local sem Docker aponte para uma pasta gravável

# ── Email transacional — escolha UM provedor (comente os demais) ─────────────
#
# Opção 1: Brevo (recomendado) — 300 emails/dia grátis, SMTP puro, sem SDK
# EMAIL_SMTP=smtp-relay.brevo.com
# EMAIL_PORTA=587
# EMAIL_USER=seu-login-cadastrado@dominio.com   # e-mail de cadastro na Brevo
# EMAIL_PASS=xSMTP-KEY-GERADA-NO-DASHBOARD      # Brevo > Configurações > SMTP e API
# EMAIL_FROM=noreply@seu-dominio.com

# Opção 2: Gmail App Password — somente dev local, não usar em produção
EMAIL_SMTP=smtp.gmail.com
EMAIL_PORTA=587
EMAIL_USER=seu@email.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# Bypass de verificação de email (SOMENTE DEV — default OFF em produção)
# SKIP_EMAIL_VERIFICATION=1

# Debug remoto via debugpy (SOMENTE DEV — default OFF em produção).
# Se true, troca gunicorn por `flask run` com debugpy escutando na porta 5678
# (attach pelo VS Code). NUNCA habilite em produção.
# DEBUGPY_ENABLED=true

# URL base da aplicação (usada nos links de email)
APP_BASE_URL=https://seu-dominio.com

# Fila Redis + RQ (email assíncrono)
# Ausente → dev sem fila (executa síncrono com warning)
# Presente mas Redis offline → produção loga erro, NÃO executa síncrono
REDIS_URL=redis://redis:6379/0

# Backup automático (container backup)
BACKUP_RETENTION_DAYS=7   # dias para manter — backups mais antigos são apagados automaticamente

# Backup externo (Backblaze B2 + Healthchecks.io)
# Ausência de TODAS estas variáveis = cópia externa desligada (dev). Preencher só parte = erro.
# Bucket B2 privado com Object Lock (retenção 30 dias) criado já com Object Lock habilitado.
# Chave de aplicação restrita a esse bucket, SEM a permissão deleteFiles.
B2_ACCOUNT_ID=
B2_APP_KEY=
B2_BUCKET=
# Senha e salt do rclone crypt: texto puro aqui (o script obscurece sozinho).
# GUARDE NO GERENCIADOR DE SENHAS: sem eles o backup externo é ilegível.
CRYPT_PASSWORD=
CRYPT_SALT=
# URLs de ping do Healthchecks.io (checks backup-local e backup-externo; contêm UUID secreto)
HC_BACKUP_URL=
HC_OFFSITE_URL=

# Super-admin do SaaS — acessa /superadmin para gerenciar tenants
# ATENÇÃO: este email NÃO pode já existir como usuário comum no banco.
# Use um email dedicado que nunca tenha sido cadastrado via signup:
# `flask create-superadmin` recusa (não promove automaticamente um usuário existente).
# SUPERADMIN_EMAIL=admin@seudominio.com